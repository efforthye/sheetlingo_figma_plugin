{
  "name": "sheetlingo",
  "version": "0.6.0",
  "private": true,
  "description": "Sheetlingo — sync Figma text with Google Sheets by key, in any language.",
  "scripts": {
    "watch": "concurrently -k -n code,ui -c green,cyan \"node scripts/build-code.mjs --watch\" \"vite build --watch --mode development\"",
    "build": "tsc --noEmit && node scripts/build-code.mjs && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
